/* sidebar blurred avatar background */

/* if backdrop-filter is supported, */
/* set the user avatar (if any) as a background so */
/* it can be blurred by the tag panel and room list */

.mx_RoomSublist_showNButton {
    background-color: transparent !important;
}

/*
    data-kind is used by the Compound <Link> component and therefore does not override them.
    This is horrible, but will get less horrible when links in the app are replaced with
    <Link>.
*/
a:not([data-kind]) {
    &:hover,
    &:link,
    &:visited {
        text-decoration: none;
    }
}

/* ==========================================================================
   thehegeo — các "vá" hành vi bố cục riêng của bản fork.
   Token trình bày đã chuyển sang res/css/_hg-tokens.pcss (Quietwork) để cả 8
   theme đều nhận được, kể cả legacy/custom vốn không import file này.
   Phần tinh chỉnh thị giác nằm ở res/themes/light/css/_hg-polish.pcss.
   ========================================================================== */

/* Bôi chọn văn bản tô theo accent — một chi tiết nhỏ nhưng thấy ngay là có người chăm. */
::selection {
    background-color: color-mix(in srgb, var(--cpd-color-bg-accent-rest) 26%, transparent);
}

/* Ẩn hẳn mọi toast thông báo ở góc (vd "Turn on key storage") theo yêu cầu —
   không hiển thị thông báo nào. Lưu ý: cũng ẩn các nhắc nhở bảo mật/xác minh. */
.mx_ToastContainer,
.mx_NonUrgentToastContainer {
    display: none !important;
}

/* Thu gọn danh sách phòng: khi bật, LoggedInView bỏ HẲN cột trái + resizer và render khung chat
   trong container này. Container phải lấp đầy .mx_MatrixChat theo cả 2 chiều để khung chat nở toàn màn. */
.mx_MainSplit_leftCollapsed {
    display: flex !important;
    flex: 1 1 0% !important;
    min-width: 0 !important;
    min-height: 0 !important;
    width: 100% !important;
    height: 100% !important;
}

.mx_MainSplit_leftCollapsed > .mx_RoomView_wrapper {
    display: flex !important;
    flex: 1 1 0% !important;
    min-width: 0 !important;
    min-height: 0 !important;
    width: 100% !important;
    height: 100% !important;
}

/* Gỡ bỏ giới hạn max-width 1200px mặc định trong layout bong bóng (bubble layout)
   để khung tin nhắn và ô nhập liệu mở rộng tràn đầy 100% chiều ngang màn hình. */
.mx_RoomView_body[data-layout="bubble"] .mx_RoomView_timeline,
.mx_RoomView_body[data-layout="bubble"] .mx_RoomView_statusArea,
.mx_RoomView_body[data-layout="bubble"] .mx_MessageComposer,
.mx_MainSplit_leftCollapsed .mx_RoomView_timeline,
.mx_MainSplit_leftCollapsed .mx_RoomView_statusArea,
.mx_MainSplit_leftCollapsed .mx_MessageComposer {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
}
