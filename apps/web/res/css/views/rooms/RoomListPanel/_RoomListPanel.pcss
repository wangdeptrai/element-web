.mx_RoomListPanel {
    /* Nền panel riêng (khác canvas của timeline) → phân lớp 3 cột, có chiều sâu, bớt đơn điệu.
       Dùng đúng token "panels" của Element ($panels = bg-subtle-secondary). */
    background-color: var(--cpd-color-bg-subtle-secondary);
    height: 100%;
}

/* Hàng đầu danh sách phòng: avatar (menu người dùng) + ô tìm kiếm, cùng một dòng.
   Thay cho cột SpacePanel bên trái đã bỏ. Cao 64px cho khớp với header phòng. */
.mx_RoomListPanel_header {
    display: flex;
    align-items: center;
    height: 64px;
    box-sizing: border-box;
    padding-left: var(--cpd-space-3x);
    border-bottom: var(--cpd-border-width-1) solid var(--cpd-color-bg-subtle-primary);

    /* Avatar: bỏ margin dọc vốn dành cho thanh rail dọc; giữ gọn trong hàng. */
    .mx_UserMenu {
        flex-shrink: 0;
        margin: 0;
    }

    /* Ô tìm kiếm chiếm phần còn lại; bỏ viền/chiều-cao riêng của nó vì hàng này
       đã tự có viền dưới + chiều cao, tránh nhân đôi. */
    [data-testid="room-list-search"] {
        flex: 1;
        min-width: 0;
        min-height: auto;
        border-bottom: none;
    }
}
