{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "defaultBase": "develop",
    "targetDefaults": {
        "build": {
            "dependsOn": ["^build", "prebuild:*"]
        }
    },
    "namedInputs": {
        "src": ["{projectRoot}/src/**/*"]
    },
    "pluginsConfig": {
        "@nx/js": {
            "analyzeLockfile": false
        }
    },
    "analytics": false
}
